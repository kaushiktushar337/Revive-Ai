REVIVE_ENV=development
CORS_ORIGINS=*
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# Keep true until Razorpay test credentials are verified.
MOCK_EXTERNAL_ACTIONS=true

# Email recovery (mocked by default)
MOCK_EMAIL_ACTIONS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@revive.local
DEFAULT_RECOVERY_EMAIL=demo@example.com

# Merchant authentication
REVIVE_AUTH_SECRET=change-this-in-development
REVIVE_TOKEN_TTL=86400

# Optional hosted PostgreSQL/Supabase connection. Leave blank to use local SQLite.
DATABASE_URL=
