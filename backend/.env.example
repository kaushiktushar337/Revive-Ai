REVIVE_ENV=development
CORS_ORIGINS=*
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
MOCK_EXTERNAL_ACTIONS=true

# Hosted transactional email: configure these as Render environment variables.
# Verify EMAIL_FROM/domain in Brevo. Recipients can be any valid email address.
EMAIL_PROVIDER=demo
BREVO_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=ReviveAI
DEFAULT_RECOVERY_EMAIL=demo@example.com

REVIVE_AUTH_SECRET=change-this-in-development
REVIVE_TOKEN_TTL=86400
DATABASE_URL=
PUBLIC_BASE_URL=http://127.0.0.1:8000
